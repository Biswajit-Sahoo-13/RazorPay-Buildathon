# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Payments ──────────────────────────────────────────────────────────────
# Auto-detected: if BOTH Razorpay test keys are set, the real Razorpay
# Orders API (test mode) is used. Otherwise a built-in mock gateway that
# mirrors Razorpay's order lifecycle + signature verification is used.
# Force one explicitly with PAYMENT_PROVIDER=mock | razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_PROVIDER=mock

# ── Optional LLM (OpenAI-compatible; e.g. GLM, OpenAI, any compatible host)
# When unset the deterministic NLU engine drives the agent — fully offline.
# When set, the same tool contract is driven by the LLM with the same
# guardrails underneath.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# ── Guardrails (paise; ₹1 = 100 paise) ───────────────────────────────────
MAX_PER_TRANSACTION_PAISE=500000
MAX_SESSION_SPEND_PAISE=1500000
MAX_QTY_PER_SKU=5
MAX_CART_ITEMS=20
COUPON_MAX_PERCENT=20
COUPON_MAX_PAISE=100000
